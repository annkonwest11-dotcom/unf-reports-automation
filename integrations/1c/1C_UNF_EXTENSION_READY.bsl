/**
 * РАСШИРЕНИЕ 1С:УНФ 3.0
 * Интеграция с Google Apps Script для отправки отчетов
 *
 * Установка:
 * 1. Сохрани этот файл как UNF_Reports.bsl
 * 2. В Конфигураторе: Конфигурация → Расширения → Загрузить расширение → выбери файл
 * 3. Установи в обе базы (Перфильев и Губарев)
 *
 * ПАРАМЕТРЫ (отредактируй перед использованием):
 */

// ===== КОНФИГУРАЦИЯ =====

// URL Google Apps Script Web App (получишь после развертывания)
// Пример: https://script.google.com/macros/d/Abcd12345.../usercurrentUserOnly
Процедура УстановитьПараметрыПриИнициализации()
	КонстантныеПараметры = Новый Структура;
	КонстантныеПараметры.Вставить("ГАС_URL", "https://script.google.com/macros/d/1v0wRnUkCW020iG7FUM8ifjuXah8ZzMEXFpoZIXnGQHD0ctAnQKCBgfXe/usercurrentUserOnly");
	КонстантныеПараметры.Вставить("АвтоТокен", "unf2tg_a7Kд9P2mQ8xL5fR3vT6wZ1nB4hJ0sC");
	КонстантныеПараметры.Вставить("БазаID", ПолучитьИДентификаторБазы());
	КонстантныеПараметры.Вставить("ВремяОтправки", "09:30"); // Время ежедневного отчета (МСК)

КонецПроцедуры

// ===== ФУНКЦИИ ПОМОЩНИКИ =====

Функция ПолучитьИДентификаторБазы()
	// Определяем какая это база по ее идентификатору
	// Вернет "perfilev" или "gubarev"

	РеквизитыБазы = ПолучитьИнформациюОБазе();

	Если СтрНайти(РеквизитыБазы.Путь, "152757") > 0 Тогда
		Возврат "perfilev";
	ИначеЕсли СтрНайти(РеквизитыБазы.Путь, "64904") > 0 Тогда
		Возврат "gubarev";
	Иначе
		// Если не можем определить по пути, используем переменную окружения
		// или свойство базы
		Возврат "unknown";
	КонецЕсли;

КонецФункции

Функция ПолучитьПараметр(ИмяПараметра)
	УстановитьПараметрыПриИнициализации();

	Если КонстантныеПараметры.Есть(ИмяПараметра) Тогда
		Возврат КонстантныеПараметры[ИмяПараметра];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Процедура Логировать(Сообщение, УровеньСообщения = "Информация")
	ЗаписьЖурнала("УНФ.ОтправкаОтчетов", УровеньСообщения, , , Сообщение);
	Если УровеньСообщения = "Ошибка" Тогда
		ПоказатьОповещение(Сообщение, , , БиблиотекаКартинок.ОшибкаКартина);
	КонецЕсли;
КонецПроцедуры

// ===== СБОР ПОКАЗАТЕЛЕЙ =====

Функция ПолучитьПоказателиПериода(ДатаНачала, ДатаКонца)
	/**
	 * Собирает все показатели за период
	 * Возвращает структуру с метриками для отправки в GAS
	 */

	Показатели = Новый Структура;

	// 1. Взаиморасчеты
	Показатели.Вставить("settlements", ПолучитьВзаиморасчеты(ДатаНачала, ДатаКонца));

	// 2. Продажи
	Показатели.Вставить("sales", ПолучитьПродажи(ДатаНачала, ДатаКонца));

	// 3. Активность клиентов
	Показатели.Вставить("clients_activity", ПолучитьАктивностьКлиентов(ДатаНачала, ДатаКонца));

	// 4. Дебиторская задолженость
	Показатели.Вставить("receivables", ПолучитьДебиторку(ДатаНачала, ДатаКонца));

	Возврат Показатели;

КонецФункции

Функция ПолучитьВзаиморасчеты(ДатаНачала, ДатаКонца)
	/**
	 * Получить сальдо взаиморасчетов
	 * Использует регистры расчетов с контрагентами
	 */

	Взаиморасчеты = Новый Структура;
	Взаиморасчеты.Вставить("they_owe_us", 0);  // Контрагенты должны нам
	Взаиморасчеты.Вставить("we_owe", 0);        // Мы должны контрагентам

	// TODO: Реализовать запрос к регистру РасчетыСПокупателями
	// и РасчетыСПоставщиками за период

	// Временно возвращаем 0 для теста
	Возврат Взаиморасчеты;

КонецФункции

Функция ПолучитьПродажи(ДатаНачала, ДатаКонца)
	/**
	 * Получить показатели продаж
	 */

	Продажи = Новый Структура;
	Продажи.Вставить("total", 0);              // Сумма за период
	Продажи.Вставить("prev_total", 0);         // Сумма за предыдущий период
	Продажи.Вставить("dynamics_abs", 0);       // Изменение в рублях
	Продажи.Вставить("dynamics_pct", 0);       // Изменение в процентах
	Продажи.Вставить("avg_per_day", 0);        // Средние продажи в день
	Продажи.Вставить("forecast_turnover", 0);  // Прогноз оборота

	// TODO: Реализовать запрос к регистру Продажи
	// или к документам Реализация

	Возврат Продажи;

КонецФункции

Функция ПолучитьАктивностьКлиентов(ДатаНачала, ДатаКонца)
	/**
	 * Получить активность клиентов (растущие, падающие)
	 */

	Активность = Новый Структура;
	Активность.Вставить("growing", Новый Массив);   // Растущие
	Активность.Вставить("declining", Новый Массив); // Проседающие
	Активность.Вставить("falling", Новый Массив);   // Падающие (до 0)

	// TODO: Запрос по продажам в разрезе контрагентов

	Возврат Активность;

КонецФункции

Функция ПолучитьДебиторку(ДатаНачала, ДатаКонца)
	/**
	 * Получить дебиторскую задолженость
	 */

	Дебиторка = Новый Структура;
	Дебиторка.Вставить("total", 0);            // Общая дебиторка
	Дебиторка.Вставить("overdue", 0);          // Просроченная
	Дебиторка.Вставить("top_total", Новый Массив);    // Топ должников
	Дебиторка.Вставить("top_overdue", Новый Массив);  // Топ по просроченной

	// TODO: Запрос к регистру РасчетыСПокупателями с анализом сроков

	Возврат Дебиторка;

КонецФункции

// ===== ОТПРАВКА ДАННЫХ =====

Процедура ОтправитьОтчет(ДатаНачала, ДатаКонца, ТипОтчета = "daily", ИДЗапроса = Неопределено)
	/**
	 * Собрать данные и отправить на GAS
	 *
	 * Параметры:
	 *   ДатаНачала - начало периода
	 *   ДатаКонца - конец периода
	 *   ТипОтчета - daily|weekly|monthly|halfyear|yearly|ondemand
	 *   ИДЗапроса - ID запроса если это команда по запросу
	 */

	Попытка
		Логировать("Начинаю отправку отчета за " + ДатаНачала + " - " + ДатаКонца);

		// 1. Собрать показатели
		Показатели = ПолучитьПоказателиПериода(ДатаНачала, ДатаКонца);

		// 2. Сформировать JSON
		ДанныеДляОтправки = СформироватьJSONОтчета(
			ДатаНачала,
			ДатаКонца,
			ТипОтчета,
			Показатели,
			ИДЗапроса
		);

		// 3. Отправить на GAS
		ОтправитьНаGAS(ДанныеДляОтправки);

		Логировать("Отчет успешно отправлен");

	Исключение
		Логировать("Ошибка при отправке отчета: " + ОписаниеОшибки(), "Ошибка");
	КонецПопытки;

КонецПроцедуры

Функция СформироватьJSONОтчета(ДатаНачала, ДатаКонца, ТипОтчета, Показатели, ИДЗапроса)
	/**
	 * Сформировать JSON по контракту с GAS
	 */

	Отчет = Новый Структура;
	Отчет.Вставить("auth_token", ПолучитьПараметр("АвтоТокен"));
	Отчет.Вставить("base_id", ПолучитьПараметр("БазаID"));
	Отчет.Вставить("report_type", ТипОтчета);
	Отчет.Вставить("period_start", Формат(ДатаНачала, "ДФ=yyyy-MM-dd"));
	Отчет.Вставить("period_end", Формат(ДатаКонца, "ДФ=yyyy-MM-dd"));
	Отчет.Вставить("generated_at", Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddThh:mm:ss+03:00"));
	Отчет.Вставить("request_id", ИДЗапроса);
	Отчет.Вставить("metrics", Показатели);

	// Преобразовать в JSON
	Писатель = Новый ЗаписьJSON;
	ПотокТекста = Новый ПотокВПамяти;
	Писатель.ОткрытьПотоки(ПотокТекста);
	Писатель.ЗаписатьСтруктуру(Отчет);

	JSON = ПолучитьСтрокуИзПотока(ПотокТекста);

	Возврат JSON;

КонецФункции

Процедура ОтправитьНаGAS(JSON)
	/**
	 * Отправить POST запрос на Google Apps Script
	 */

	Попытка
		URL = ПолучитьПараметр("ГАС_URL") + "?path=ingest";

		HTTPСоединение = Новый HTTPСоединение("script.google.com", 443, , , , , Новый СертификатBG);
		HTTPЗапрос = Новый HTTPЗапрос("", JSON);
		HTTPЗапрос.УстановитьЗаголовок("Content-Type", "application/json");

		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

		Если Ответ.КодСостояния = 200 Тогда
			Логировать("Данные успешно отправлены на GAS");
		Иначе
			Логировать("GAS ответила кодом " + Ответ.КодСостояния, "Ошибка");
		КонецЕсли;

	Исключение
		Логировать("Ошибка при отправке HTTP запроса: " + ОписаниеОшибки(), "Ошибка");
	КонецПопытки;

КонецПроцедуры

Функция ПолучитьСтрокуИзПотока(Поток)
	Поток.УстановитьПозицию(0);
	Чтение = Новый ЧтениеТекста(Поток, "UTF-8");
	Результат = Чтение.Прочитать();
	Возврат Результат;
КонецФункции

// ===== ОПРОС ОЧЕРЕДИ КОМАНД =====

Процедура ОпросОчередиКоманд()
	/**
	 * Регламентное задание
	 * Запускается каждую минуту
	 * Опрашивает очередь команд и исполняет их
	 */

	Попытка
		Логировать("Опрашиваю очередь команд");

		URL = ПолучитьПараметр("ГАС_URL") +
			"?path=commands" +
			"&auth_token=" + ПолучитьПараметр("АвтоТокен") +
			"&base_id=" + ПолучитьПараметр("БазаID");

		HTTPСоединение = Новый HTTPСоединение("script.google.com", 443, , , , , Новый СертификатBG);
		HTTPЗапрос = Новый HTTPЗапрос("");

		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);

		Если Ответ.КодСостояния = 200 Тогда
			JSON = Ответ.ПолучитьТелоКакСтроку();
			Чтение = Новый ЧтениеJSON;
			ОтветСтруктура = Новый Структура;
			Чтение.ОткрытьСтроку(JSON);
			Чтение.ПрочитатьСтруктуру(ОтветСтруктура);

			Если ОтветСтруктура.Есть("commands") Тогда
				Команды = ОтветСтруктура["commands"];

				Для каждого Команда Из Команды Цикл
					ОбработатьКоманду(Команда);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;

	Исключение
		Логировать("Ошибка при опросе очереди: " + ОписаниеОшибки(), "Ошибка");
	КонецПопытки;

КонецПроцедуры

Процедура ОбработатьКоманду(Команда)
	/**
	 * Обработать команду из очереди
	 */

	ДатаНачала = Дата(Команда["period_start"]);
	ДатаКонца = Дата(Команда["period_end"]);
	ТипОтчета = Команда["report_type"];
	ИДЗапроса = Команда["request_id"];

	Логировать("Обрабатываю команду: " + ТипОтчета + " за " + ДатаНачала + " - " + ДатаКонца);

	// Отправить отчет
	ОтправитьОтчет(ДатаНачала, ДатаКонца, ТипОтчета, ИДЗапроса);

КонецПроцедуры

// ===== РЕГЛАМЕНТНЫЕ ЗАДАНИЯ =====

Процедура ОтправкаОтчетовРегламент() Экспорт
	/**
	 * Регламентное задание: ежедневная отправка отчета
	 *
	 * УСТАНОВКА:
	 * 1. Конфигурация → Регламентные задания → Новое
	 * 2. Имя: "ОтправкаОтчетовУНФ"
	 * 3. Процедура: УНФ.ОтправкаОтчетовРегламент
	 * 4. Расписание: Ежедневно в 09:30 МСК
	 */

	СегодняДата = ТекущаяДата();
	ДатаНачала = НачалоДня(СегодняДата);
	ДатаКонца = КонецДня(СегодняДата);

	Логировать("Регламентное задание: отправка ежедневного отчета");
	ОтправитьОтчет(ДатаНачала, ДатаКонца, "daily");

КонецПроцедуры

Процедура ОпросОчередиКомандРегламент() Экспорт
	/**
	 * Регламентное задание: опрос очереди команд
	 *
	 * УСТАНОВКА:
	 * 1. Конфигурация → Регламентные задания → Новое
	 * 2. Имя: "ОпросОчередиКомандУНФ"
	 * 3. Процедура: УНФ.ОпросОчередиКомандРегламент
	 * 4. Расписание: Каждую минуту
	 */

	ОпросОчередиКоманд();

КонецПроцедуры

// ===== ХЕКЛЕРЫ ХЕТКИЖЕ =====

Процедура ТестЕжедневногоОтчета() Экспорт
	/**
	 * Тестирование - ручная отправка ежедневного отчета
	 * Вызвать: ОтправитьОтчет_Тест()
	 */

	СегодняДата = ТекущаяДата();
	ДатаНачала = НачалоДня(СегодняДата);
	ДатаКонца = КонецДня(СегодняДата);

	ПоказатьСообщение("Отправляю тестовый отчет...");
	ОтправитьОтчет(ДатаНачала, ДатаКонца, "daily");
